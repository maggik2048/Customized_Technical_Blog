# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# =========================================================
# 3D MODEL ASSETS
# =========================================================

# model storage directories
/public/models/*
!/public/models/.gitkeep

/public/materials/*
!/public/materials/.gitkeep

# common 3d formats
*.glb
*.gltf
*.fbx
*.obj
*.mtl
*.blend
*.dae
*.3ds
*.abc
*.usd
*.usda
*.usdc
*.usdz
*.stl
*.ply
*.x3d

# compressed / baked assets
*.bin
*.ktx2
*.basis
*.hdr
*.exr

# texture assets


# baked texture maps
*_albedo.*
*_basecolor.*
*_normal.*
*_roughness.*
*_metallic.*
*_ao.*
*_height.*
*_displacement.*
*_emissive.*
*_opacity.*
*_preview.*

# =========================================================
# GENERATED RUNTIME ASSETS
# =========================================================

# autogenerated descriptors
/public/models/**/model.json
/public/materials/**/material.json